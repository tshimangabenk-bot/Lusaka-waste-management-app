# =============================================================================
# Smart Waste Management System — Environment Variables
# Copy this file to .env and fill in actual values
# =============================================================================

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret-string

# Database  (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_waste_lusaka

# JWT Authentication
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# MQTT Broker  (IoT Sensor Data)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_SENSOR=smart_waste/sensors/#
MQTT_USERNAME=
MQTT_PASSWORD=

# Google Maps API  (Route Optimization)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# AWS / S3  (Image uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=smart-waste-lusaka
AWS_REGION=af-south-1
