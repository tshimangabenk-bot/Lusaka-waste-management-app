# =============================================================================
# Smart Waste Management System — Environment Variables
# Copy this file to .env and fill in actual values
# =============================================================================

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret-string

# Database  (MariaDB via XAMPP)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# XAMPP default: root user, no password, port 3306
DATABASE_URL=mysql+pymysql://root:@localhost:3306/smart_waste_lusaka

# JWT Authentication
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# MQTT Broker  (IoT Sensor Data)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_SENSOR=smart_waste/sensors/#
MQTT_USERNAME=
MQTT_PASSWORD=

# Google Maps API  (Route Optimization)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Firebase  (Auth token verification, Storage image uploads, FCM push notifications)
# Download service account JSON from Firebase Console → Project Settings → Service Accounts
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
